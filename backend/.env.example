# Server
NODE_ENV=development
PORT=3003

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=alexandria_edu

# JWT (CHANGE IN PRODUCTION)
JWT_SECRET=alexandria-dev-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=1h

# HMAC (CHANGE IN PRODUCTION)
HMAC_SECRET=alexandria-dev-hmac-secret-change-me-in-production

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Live Classes ───────────────────────────────────────────────────────────
# Secret separado para os tokens de entrada em aula (fallback: JWT_SECRET)
LIVE_CLASS_JWT_SECRET=alexandria-live-class-token-secret-change-me

# URL base do frontend (usada em e-mails/notificações)
FRONTEND_URL=http://localhost:5173

# ─── Stripe (pagamentos BRL) ────────────────────────────────────────────────
# Sem essas variáveis, o checkout só aceita cobranças totalmente em moedas/gratuitas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── E-mail (notificações) ──────────────────────────────────────────────────
# Sem SMTP_HOST as notificações são apenas in-app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Alexandria EDU <noreply@alexandria.edu>"

# ─── LiveKit (futuro – ver docs/LIVEKIT-INTEGRATION.md) ─────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

